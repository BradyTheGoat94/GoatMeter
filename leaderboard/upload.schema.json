{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoatMeter per-target fight export v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "boss",
    "startedUtc",
    "durationSeconds",
    "visibility",
    "players",
    "targets",
    "rankingTargetId"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "boss": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "startedUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 1,
      "maximum": 7200
    },
    "visibility": {
      "enum": [
        "private",
        "unlisted",
        "public"
      ]
    },
    "players": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "className",
          "damage"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "className": {
            "enum": [
              "Gladiator",
              "Templar",
              "Assassin",
              "Ranger",
              "Sorcerer",
              "Spiritmaster",
              "Cleric",
              "Chanter",
              "Unknown"
            ]
          },
          "damage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "serverId": {
            "minimum": 1001,
            "maximum": 9999,
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "rankingTargetId": {
      "pattern": "^target-\\d{2}$",
      "description": "Choose a target ID before API upload; desktop exports start with null.",
      "type": [
        "string",
        "null"
      ]
    },
    "targets": {
      "maxItems": 64,
      "minItems": 1,
      "items": {
        "additionalProperties": false,
        "properties": {
          "damageByPlayer": {
            "maxItems": 24,
            "minItems": 1,
            "items": {
              "minimum": 0,
              "type": "integer",
              "maximum": 1000000000000
            },
            "type": "array"
          },
          "id": {
            "type": "string",
            "pattern": "^target-\\d{2}$"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "durationSeconds": {
            "minimum": 1,
            "maximum": 7200,
            "description": "Observed target first-to-last player damage window, bounded by encounter duration.",
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "damageByPlayer",
          "durationSeconds"
        ],
        "type": "object"
      },
      "type": "array"
    }
  }
}
