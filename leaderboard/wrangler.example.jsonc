{
  // Review and fill account/database bindings only after deployment approval.
  "name": "goatmeter-fight-logs-test",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "UPLOADS_ENABLED": "false" },
  "d1_databases": [{ "binding": "DB", "database_name": "goatmeter-fights-test", "database_id": "REPLACE_WITH_SEPARATE_TEST_DATABASE_ID" }],
  "ratelimits": [{ "name": "UPLOAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }]
}
