<Window x:Class="Aion2DPSPro.Overlay.OverlayWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:Aion2DPSPro.Overlay"
 Title="GoatMeter Overlay" Icon="/GoatMeter;component/Assets/Brand/GoatHead.png" AllowsTransparency="True" Background="Transparent" WindowStyle="None" Topmost="True" ShowInTaskbar="False"
 ResizeMode="CanResizeWithGrip" Width="780" Height="560" MinWidth="560" MinHeight="380">
 <Window.Resources>
    <icons:ClassIconConverter x:Key="ClassIconConverter"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F4F7FF"/></Style>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.5"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Setter Property="Background" Value="#14284A"/><Setter Property="Foreground" Value="#EAF2FF"/><Setter Property="BorderBrush" Value="#2F80ED"/><Setter Property="Padding" Value="9,4"/><Setter Property="Margin" Value="3,0"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#D9E8FF"/><Setter Property="Background" Value="#0E1C35"/><Setter Property="BorderBrush" Value="#2F80ED"/><Setter Property="Padding" Value="12,5"/></Style>

  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E6EEF9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Padding="10,7" Background="#111C30"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#244663"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#E6EEF9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
   <ToggleButton Foreground="#E6EEF9" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border TextElement.Foreground="#E6EEF9" Background="#172940" BorderBrush="#35506E" BorderThickness="1" CornerRadius="4"><Grid Margin="9,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions><ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="⌄" Foreground="#91B7D5"/></Grid></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
   <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#111C30" BorderBrush="#35506E" BorderThickness="1" Padding="3" MinWidth="150"><ScrollViewer MaxHeight="300"><StackPanel IsItemsHost="True"/></ScrollViewer></Border></Popup>
  </Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ProgressBar"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Border x:Name="PART_Track" Background="{TemplateBinding Background}"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="Item" BorderBrush="Transparent" BorderThickness="1" Background="Transparent" CornerRadius="3"><StackPanel><ContentPresenter/><TextBlock Text="{Binding CharacterStats}" Margin="8,0,8,3" FontSize="10" Foreground="#91A7C7" ToolTip="Experimental roster metadata • unknown stays blank • expires after 10 minutes"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="#D9E8FF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="#302F80ED"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <DataTemplate x:Key="PulseRows">
   <Border Background="#50202B42" CornerRadius="12" Padding="12,8" Margin="4,4"><Grid Height="58"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
    <Border CornerRadius="18" BorderBrush="{Binding Brush}" BorderThickness="1" Width="34" Height="34" VerticalAlignment="Center"><Image Source="{Binding ClassName, Converter={StaticResource ClassIconConverter}}" Width="24" Height="24"/></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding ClassName}" Foreground="{Binding Brush}" FontSize="10" Margin="0,3,0,0"/><ProgressBar Value="{Binding Relative}" Maximum="100" Foreground="{Binding Brush}" Background="#18253650" Height="3" Margin="0,8,12,0"/></StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Dps}" FontSize="26" FontWeight="Light" HorizontalAlignment="Right"/><TextBlock Text="{Binding Damage}" Foreground="#9BADC8" FontSize="11" HorizontalAlignment="Right"/></StackPanel><TextBlock Grid.Column="3" Text="{Binding Share}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Brush}"/>
   </Grid></Border>
  </DataTemplate>
  <DataTemplate x:Key="NeonRows">
   <Grid Height="44" Margin="10,4"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="80"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Rank}" VerticalAlignment="Center" Foreground="#8197AD"/><Image Grid.Column="1" Source="{Binding ClassName, Converter={StaticResource ClassIconConverter}}" Width="22" Height="22"/>
    <Grid Grid.Column="2" Margin="10,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="4"/></Grid.RowDefinitions><TextBlock Text="{Binding Name}" Foreground="{Binding Brush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><ProgressBar Grid.Row="1" Value="{Binding Relative}" Maximum="100" Foreground="{Binding Brush}" Background="#20293A51"/></Grid>
    <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="{Binding Dps}" FontSize="20" FontWeight="Light" HorizontalAlignment="Right"/><TextBlock Text="{Binding Damage}" FontSize="10" Foreground="#8197AD" HorizontalAlignment="Right"/></StackPanel><TextBlock Grid.Column="4" Text="{Binding Share}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#ABBED7" FontSize="11"/>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="EncounterRows">
   <Grid Height="62" Margin="0,2" ClipToBounds="True">
    <Grid Margin="10,0,10,12"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition Width="70"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Rank, StringFormat={}{0:00}}" Foreground="#8290A4" VerticalAlignment="Center" FontSize="14"/>
     <Image Grid.Column="1" Source="{Binding ClassName, Converter={StaticResource ClassIconConverter}}" Width="28" Height="28"/>
     <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding ClassName}" Foreground="{Binding Brush}" FontSize="10"/></StackPanel>
     <TextBlock Grid.Column="3" Text="{Binding Damage}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="16" Foreground="#BAC5D5"/>
     <TextBlock Grid.Column="4" Text="{Binding Share}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" Foreground="#93A2B7"/>
     <TextBlock Grid.Column="5" Text="{Binding Dps}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="24" FontWeight="Bold"/>
    </Grid>
    <ProgressBar Height="4" Margin="44,0,10,3" VerticalAlignment="Bottom" Value="{Binding Relative}" Maximum="100" Foreground="{Binding Brush}" Background="#1528384C" IsHitTestVisible="False"/>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="ModernRows">
   <Border CornerRadius="8" Background="#40152032" Margin="0,2" ClipToBounds="True">
    <Grid Height="52">
     <ProgressBar Value="{Binding Relative}" Maximum="100" Foreground="{Binding Brush}" Background="Transparent" Opacity="0.10" IsHitTestVisible="False"/>
     <Border Width="3" Background="{Binding Brush}" HorizontalAlignment="Left" CornerRadius="2" Margin="0,8"/>
     <Grid Margin="12,4"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="92"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Rank}" Foreground="#8091AA" VerticalAlignment="Center" FontSize="12"/>
      <Image Grid.Column="1" Width="23" Height="23" Source="{Binding ClassName, Converter={StaticResource ClassIconConverter}}"/>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding ClassName}" Foreground="{Binding Brush}" FontSize="10"/></StackPanel>
      <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="{Binding Dps}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="{Binding Damage}" Foreground="#8F9FB7" FontSize="10" HorizontalAlignment="Right" ToolTip="Total for the selected category"/></StackPanel>
      <TextBlock Grid.Column="4" Text="{Binding Share}" Foreground="#A8B7CC" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
     </Grid>
    </Grid>
   </Border>
  </DataTemplate>
  <DataTemplate x:Key="DetailsRows">
   <Grid Height="32" ClipToBounds="True" Background="#402D3749">
    <ProgressBar Value="{Binding Relative}" Maximum="100" Foreground="{Binding Brush}" Background="Transparent" Opacity="0.45" IsHitTestVisible="False"/>
    <Grid Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="84"/><ColumnDefinition Width="76"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Rank}" VerticalAlignment="Center" FontWeight="Bold"/>
     <Image Grid.Column="1" Width="19" Height="19" Source="{Binding ClassName, Converter={StaticResource ClassIconConverter}}"/>
     <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="SemiBold" ToolTip="{Binding Name}"/>
     <TextBlock Grid.Column="3" Text="{Binding Damage}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
     <TextBlock Grid.Column="4" Text="{Binding Dps}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold"/>
     <TextBlock Grid.Column="5" Text="{Binding Share}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
    </Grid>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="KagerouRows">
   <Grid Height="43" ClipToBounds="True" Background="#18101723">
    <ProgressBar Value="{Binding Relative}" Maximum="100" Foreground="{Binding Brush}" Background="Transparent" Opacity="0.13" IsHitTestVisible="False"/>
    <ProgressBar Height="2" VerticalAlignment="Bottom" Value="{Binding Relative}" Maximum="100" Foreground="{Binding Brush}" Background="#252E3A50" IsHitTestVisible="False"/>
    <Grid Margin="7,3"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="27"/><ColumnDefinition/><ColumnDefinition Width="85"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Rank}" VerticalAlignment="Center" Foreground="#8797B0" FontSize="11"/>
     <Image Grid.Column="1" Width="19" Height="19" Source="{Binding ClassName, Converter={StaticResource ClassIconConverter}}"/>
     <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{Binding Brush}" FontWeight="SemiBold" ToolTip="{Binding Name}"/><TextBlock Text="{Binding ClassName}" FontSize="10" Foreground="#8797B0"/></StackPanel>
     <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="{Binding Dps}" FontSize="17" FontWeight="Light" HorizontalAlignment="Right"/><TextBlock Text="{Binding Damage}" FontSize="10" Foreground="#8797B0" HorizontalAlignment="Right"/></StackPanel>
     <TextBlock Grid.Column="4" Text="{Binding Share}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#AFC0D9" FontSize="11"/>
    </Grid>
   </Grid>
  </DataTemplate>
     <DataTemplate x:Key="ClassicRows"><Grid Height="42" Margin="2"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="76"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Rank}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#8FB8FF"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="Bold" Foreground="{Binding Brush}"/><StackPanel Orientation="Horizontal"><Image Width="14" Height="14" Margin="0,0,4,0" Source="{Binding ClassName, Converter={StaticResource ClassIconConverter}}"/><TextBlock Text="{Binding ClassName}"/></StackPanel></StackPanel>
      <ProgressBar Grid.Column="2" Margin="8,8" Background="#1B2B4D" Foreground="{Binding Brush}" Value="{Binding Relative}" Maximum="100" IsHitTestVisible="False"/>
      <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="{Binding Dps}" HorizontalAlignment="Right" FontWeight="SemiBold"/><TextBlock Text="{Binding Damage}" HorizontalAlignment="Right" FontSize="10" Foreground="#AFC9EF"/></StackPanel>
      <TextBlock Grid.Column="4" Text="{Binding Share}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{Binding Brush}"/>
     </Grid></DataTemplate>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="#101A2D"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#35506E" CornerRadius="5" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Vertical"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Border x:Name="Root" Background="#F20A1630" BorderBrush="#E53935" BorderThickness="1.4" CornerRadius="9">
  <Grid x:Name="MainGrid">
   <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="66"/></Grid.RowDefinitions>
   <Border x:Name="HeaderBar" MouseLeftButtonDown="Drag" Grid.Row="0" Background="#101F3D" CornerRadius="8,8,0,0" BorderBrush="#2F80ED" BorderThickness="0,0,0,1">
    <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/GoatMeter;component/Assets/Brand/GoatHead.png" Width="28" Height="28" Margin="0,0,8,0"/><TextBlock x:Name="TitleAion" Text="Goat" FontSize="20" FontWeight="Bold" Foreground="#8FB8FF"/><TextBlock x:Name="TitleDps" Text="Meter" FontSize="20" FontWeight="Bold" Foreground="#FF4D5A"/><Border x:Name="PreviewBadge" Background="#A8322630" CornerRadius="4" Margin="12,0,0,0" Padding="7,2"><TextBlock Text="SIMULATED PREVIEW" FontWeight="Bold" Foreground="#FFB3B8" FontSize="11"/></Border></StackPanel>
     <TextBlock x:Name="GroupDps" Grid.Column="1" Foreground="#8FB8FF" Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="Timer" Text="00:00" FontWeight="SemiBold"/><Button Content="◷" ToolTip="Event and Spacetime Rift countdowns" AutomationProperties.Name="Open event countdowns" Click="OpenEventTimers"/><Button x:Name="ResetCurrentFight" Content="↻" AutomationProperties.Name="Reset current fight" ToolTip="Reset current fight — keeps overall totals and saves the finished fight" Click="ResetCurrentFightClicked"/><Button Content="⚙" ToolTip="Overlay settings" Click="OpenSettings"/><Button Content="×" Click="CloseOverlay"/></StackPanel>
    </Grid>
   </Border>
   <Grid x:Name="ToolbarGrid" Grid.Row="1" Margin="10,5,10,3">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
    <ScrollViewer x:Name="CategoryTabs" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0"><TabItem Header="Damage"/><TabItem Header="Healing"/><TabItem Header="Damage Taken"/><TabItem Header="Deaths" ToolTip="Aggregation supported; live opcode unverified"/><TabItem Header="Buffs" ToolTip="Aggregation supported; live opcode unverified"/><TabItem Header="Debuffs" ToolTip="Aggregation supported; live opcode unverified"/><TabItem Header="Interrupts" ToolTip="Aggregation supported; live opcode unverified"/><TabItem Header="Dispels" ToolTip="Aggregation supported; live opcode unverified"/></TabControl></ScrollViewer>
    <ComboBox x:Name="CategoryPicker" Width="150" Height="28" HorizontalAlignment="Left" Visibility="Collapsed" SelectionChanged="CategoryChanged"/>
    <ComboBox x:Name="FightHistory" Grid.Column="1" Height="28" Margin="4,0" DisplayMemberPath="Label" DropDownOpened="RefreshFightHistory" SelectionChanged="FightHistoryChanged" ToolTip="Browse stored fights"/>
    <ComboBox x:Name="Segment" Grid.Column="2" Width="130" Height="28" SelectedIndex="0" Background="#14284A" Foreground="White" SelectionChanged="SegmentChanged"><ComboBoxItem Content="Current Fight"/><ComboBoxItem Content="Previous Fight"/><ComboBoxItem Content="Overall"/></ComboBox>
   </Grid>
   <Grid x:Name="ContentGrid" Grid.Row="2" Margin="12,4,12,6">
    <Grid.RowDefinitions><RowDefinition Height="0"/><RowDefinition Height="0"/><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <Grid x:Name="EncounterSummary" Grid.ColumnSpan="3" Visibility="Collapsed" Margin="10,4,10,8" MouseLeftButtonDown="Drag">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock x:Name="EncounterTarget" Text="Waiting for combat" FontSize="26" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="EncounterContext" Foreground="#91A1BA" FontSize="11" Margin="0,5,0,0"/><ProgressBar x:Name="EncounterHp" Height="3" Maximum="100" Margin="0,10,20,0" Foreground="#F25F6C" Background="#1F2C3E"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock x:Name="EncounterTime" Text="00:00" FontSize="32" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock x:Name="EncounterRate" FontSize="12" Foreground="#91B9E8" HorizontalAlignment="Right" Margin="0,3,0,0"/></StackPanel>
    </Grid>
    <Grid x:Name="EncounterColumns" Grid.Row="1" Visibility="Collapsed" Margin="11,0,25,0"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition Width="70"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
     <TextBlock Grid.Column="2" Text="PLAYER" FontSize="10" Foreground="#8595AF" Margin="10,0,0,0"/><TextBlock x:Name="EncounterTotalLabel" Grid.Column="3" Text="DAMAGE" FontSize="10" Foreground="#8595AF" HorizontalAlignment="Right"/><TextBlock Grid.Column="4" Text="SHARE" FontSize="10" Foreground="#8595AF" HorizontalAlignment="Right"/><TextBlock x:Name="EncounterRateLabel" Grid.Column="5" Text="DPS" FontSize="10" Foreground="#8595AF" HorizontalAlignment="Right"/>
    </Grid>
    <Grid x:Name="EncounterControls" Grid.Row="3" Grid.ColumnSpan="3" Visibility="Collapsed" Margin="6,8,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
     <Button x:Name="PositionLock" Content="Lock position" Click="TogglePositionLock" ToolTip="Lock movement and resizing; click again to unlock" AutomationProperties.Name="Toggle overlay position lock"/>
     <TextBlock Grid.Column="1" Text="Opacity" Foreground="#91A1BA" Margin="12,0" VerticalAlignment="Center"/>
     <Slider x:Name="QuickOpacity" Grid.Column="2" Minimum="0.35" Maximum="1" Value="{Binding Opacity, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Overlay opacity"/>
     <TextBlock Grid.Column="3" Text="{Binding Value, ElementName=QuickOpacity, StringFormat={}{0:P0}}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#91A1BA"/>
    </Grid>
    <ListView Grid.Row="2" x:Name="Rows" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemTemplate="{StaticResource ClassicRows}" Background="#5A081326" BorderBrush="#284E7D" Foreground="#F4F7FF" SelectionChanged="PlayerSelected" MouseDoubleClick="OpenSelectedReport" ToolTip="Click a player for details • double-click for full report">

    </ListView>
    <TextBlock Grid.Row="2" x:Name="EmptyRows" Text="No events in this category" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8797B0" IsHitTestVisible="False" Visibility="Collapsed"/>
    <Border Grid.Row="2" x:Name="DetailPanel" Grid.Column="2" Background="#70081326" BorderBrush="#284E7D" BorderThickness="1" CornerRadius="6" Padding="10">
     <StackPanel><TextBlock Text="PLAYER DETAILS" Foreground="#8FB8FF" FontWeight="Bold"/><TextBlock x:Name="SelectedPlayer" Text="Select a player" FontSize="18" FontWeight="Bold" Margin="0,8,0,2"/><TextBlock x:Name="SelectedMeta" Foreground="#AFC9EF"/>
      <Button Content="OPEN DETAILED REPORT" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OpenSelectedReport"/><Separator Margin="0,10" Background="#284E7D"/><TextBlock Text="Top Skills" FontWeight="Bold"/><ItemsControl x:Name="Skills" Margin="0,5,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Foreground="#EAF2FF"/><TextBlock Grid.Column="1" Text="{Binding Damage}" HorizontalAlignment="Right" Foreground="#FF8790"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
    </Border>
   </Grid>
   <Border x:Name="FooterBar" Grid.Row="3" Background="#101F3D" BorderBrush="#284E7D" BorderThickness="0,1,0,0" Padding="12,6" CornerRadius="0,0,8,8">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="TargetName" Text="No target" FontWeight="Bold"/><ProgressBar x:Name="BossHp" Height="9" Minimum="0" Maximum="100" Foreground="#E53935" Background="#1B2B4D" Margin="0,5,10,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="TargetHp" HorizontalAlignment="Right" Foreground="#FF8790"/><TextBlock x:Name="StatusText" HorizontalAlignment="Right" Margin="0,4,0,0" Foreground="#8FB8FF"/></StackPanel></Grid>
   </Border>
  </Grid>
 </Border>
</Window>


